# LedgerGPT Configuration Template
# Rename this file to .env and configure your keys

# Database Path (default: ledgergpt.db in root)
LEDGERGPT_DB_PATH=ledgergpt.db

# LLM Provider: 'rule_only' (default offline, no key needed), 'gemini', 'openai', 'anthropic', 'ollama'
LEDGERGPT_LLM_PROVIDER=rule_only

# Google Gemini API Key (if using gemini)
GEMINI_API_KEY=

# OpenAI API Key (if using openai)
OPENAI_API_KEY=

# Anthropic Claude API Key (if using anthropic)
ANTHROPIC_API_KEY=

# Local Ollama URL (if using ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Tally Prime Live XML Connection
TALLY_HOST=localhost
TALLY_PORT=9000

# Web Application Settings
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_DEBUG=False
